{
  "format": "muser.loop",
  "version": 1,
  "name": "breakbeat",
  "style": "breakbeat",
  "description": "big beat / breakbeat: syncopated kick, snare on 2 and 4, 8th hi-hats",
  "tags": [
    "breakbeat"
  ],
  "tempo": [
    120,
    135
  ],
  "bars": 1,
  "meter": "4/4",
  "kit": "drums.acoustic",
  "grid": {
    "kick": "x.....x...x.....",
    "snare": "....x.......x...",
    "hat": "x.x.x.x.x.x.x.x.",
    "open_hat": "..............x."
  },
  "humanize": {
    "timing_ms": 5,
    "drift": 0.6,
    "velocity": 0.08
  }
}