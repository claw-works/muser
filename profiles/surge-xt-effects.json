  "source": {
    "author": "muser",
    "tested_version": "1.3.4",
    "updated": "2026-10-25",
    "notes": "Surge XT's effects as a separate plugin: FX Type picks the effect, and the meaning of the 12 generic parameters FX Parameter 0-11 depends on the type. The LV2 build has no FX Type parameter; use the CLAP or VST3 build.",
    "lang": "en"
  },
  "params": [
    {
      "name": "FX Type",
      "alias": "type",
      "role": "type",
      "description": "Effect type. Pick the type first, then run `muser plugin params <plugin> --params '{\"FX Type\": \"...\"}'` to see what FX Parameter 0-11 mean for that type",
      "values": [
        "Delay",
        "Reverb 1",
        "Reverb 2",
        "Phaser",
        "Rotary Speaker",
        "Distortion",
        "EQ",
        "Frequency Shifter",
        "Conditioner",
        "Chorus",
