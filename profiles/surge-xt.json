{
  "schema_version": 1,
  "plugin": {
    "name": "Surge XT",
    "vendor": "Surge Synth Team",
    "ids": [
      "org.surge-synth-team.surge-xt",
      "ABCDEF019182FAEB566D624153675854",
      "https://surge-synthesizer.github.io/lv2/surge-xt"
    ]
  },
  "source": {
    "author": "muser",
    "tested_version": "1.3.4",
    "updated": "2026-10-25",
    "notes": "Surge XT is a hybrid synth with two scenes (A/B) and 775 parameters. Only the most common scene A parameters are listed; scene B has the same names (replace the leading A with B). The initial sound is an unfiltered saw (Osc 1); Osc 2/3 are muted and Filter 1 is off.",
    "lang": "en"
  },
  "setup": {
    "A Osc 1 Retrigger": "On",
    "A Osc 2 Retrigger": "On",
    "A Osc 3 Retrigger": "On"
  },
  "params": [
    {
      "name": "A Filter 1 Type",
      "alias": "filter_type",
      "role": "type",
      "description": "Filter type. It starts Off, where cutoff/resonance do nothing: pick a type first",
      "values": [
        "Off",
        "LP 12 dB",
        "LP 24 dB",
        "LP Legacy Ladder",
        "LP Vintage Ladder",
        "LP OB-Xd 24 dB",
        "LP K35",
        "LP Diode Ladder",
        "HP 12 dB",
        "HP 24 dB",
        "BP 12 dB",
        "N 12 dB",
        "FX Comb +",
        "MULTI Tri-pole"
      ]
    },
    {
      "name": "A Filter 1 Cutoff",
      "alias": "cutoff",
      "role": "cutoff",
      "description": "Cutoff: lower is duller and darker. Good for automated sweeps",
      "values": [
        "200 Hz",
        "500 Hz",
        "1000 Hz",
        "3000 Hz",
        "8000 Hz"
      ]
    },
    {
      "name": "A Filter 1 Resonance",
      "alias": "resonance",
      "role": "resonance",
      "description": "Resonance: the peak at the cutoff; higher is sharper",
      "values": [
        "0.00 %",
        "30 %",
        "60 %",
        "90 %"
      ]
    },
    {
      "name": "A Filter 1 FEG Mod Amount",
      "alias": "filter_env",
      "role": "filter_env",
      "description": "How many semitones the filter envelope pushes the cutoff. Positive = brighter at the attack, then falls back",
      "values": [
        "0.00 semitones",
        "24.00 semitones",
        "48.00 semitones"
      ]
    },
    {
      "name": "A Filter EG Attack",
      "alias": "filter_attack",
      "role": "attack",
      "values": [
        "0.0 ms",
        "50 ms",
        "500 ms"
      ]
    },
    {
      "name": "A Filter EG Decay",
      "alias": "filter_decay",
      "role": "decay",
      "description": "Filter envelope decay: short = a quick 'pop', long = a drawn-out 'wah'",
      "values": [
        "50 ms",
        "200 ms",
        "1000 ms"
      ]
    },
    {
      "name": "A Filter EG Sustain",
      "alias": "filter_sustain",
      "role": "sustain",
      "values": [
        "0.00 %",
        "50.00 %",
        "100.00 %"
      ]
    },
    {
      "name": "A Amp EG Attack",
      "alias": "attack",
      "role": "attack",
      "description": "Amp attack time",
      "values": [
        "0.0 ms",
        "10 ms",
        "300 ms",
        "1000 ms"
      ]
    },
    {
      "name": "A Amp EG Decay",
      "alias": "decay",
      "role": "decay",
      "values": [
        "100 ms",
        "250.0 ms",
        "1000 ms"
      ]
    },
    {
      "name": "A Amp EG Sustain",
      "alias": "sustain",
      "role": "sustain",
      "description": "Level held while the key is down. 0 % = attack and decay only (pluck)",
      "values": [
        "0.00 %",
        "50.00 %",
        "100.00 %"
      ]
    },
    {
      "name": "A Amp EG Release",
      "alias": "release",
      "role": "release",
      "description": "How long the sound rings after release. Only 31 ms initially, almost no tail",
      "values": [
        "31.2 ms",
        "300 ms",
        "1000 ms",
        "3000 ms"
      ]
    },
    {
      "name": "A Osc 1 Type",
      "alias": "osc_type",
      "role": "type",
      "description": "Oscillator algorithm",
      "values": [
        "Classic",
        "Sine",
        "Wavetable",
        "S&H Noise",
        "FM3",
        "FM2",
        "Window",
        "Modern",
        "String",
        "Twist",
        "Alias"
      ]
    },
    {
      "name": "A Osc 1 Octave",
      "alias": "octave",
      "role": "pitch",
      "values": [
        "-2",
        "-1",
        "0",
        "1",
        "2"
      ]
    },
    {
      "name": "A Osc 1 Unison Voices",
      "alias": "unison",
      "role": "unison",
      "description": "Number of unison voices; with detune makes the sound thicker",
      "values": [
        "1 voice",
        "3 voices",
        "5 voices"
      ]
    },
    {
      "name": "A Osc 1 Unison Detune",
      "alias": "detune",
      "role": "detune",
      "values": [
        "10.00 cents",
        "20.00 cents",
        "40.00 cents"
      ]
    },
    {
      "name": "A Osc 2 Mute",
      "alias": "osc2_mute",
      "role": "switch",
      "description": "Osc 2 starts muted; set Off to hear it",
      "values": [
        "On",
        "Off"
      ]
    },
    {
      "name": "A Osc 3 Mute",
      "alias": "osc3_mute",
      "role": "switch",
      "values": [
        "On",
        "Off"
      ]
    },
    {
      "name": "A Play Mode",
      "alias": "play_mode",
      "role": "type",
      "description": "Poly is polyphonic; the Mono modes are monophonic, use with portamento for glides",
      "values": [
        "Poly",
        "Mono",
        "Mono (Single Trigger)",
        "Mono (Fingered Portamento)"
      ]
    },
    {
      "name": "A Portamento",
      "alias": "glide",
      "role": "glide",
      "description": "Glide time (noticeable in mono modes)",
      "values": [
        "0.0 ms",
        "50 ms",
        "200 ms"
      ]
    },
    {
      "name": "A Waveshaper Type",
      "alias": "drive_type",
      "role": "type",
      "description": "Waveshaper (distortion) type, Off initially",
      "values": [
        "Off",
        "Soft",
        "Hard",
        "Asymmetric",
        "Sine",
        "Digital"
      ]
    },
    {
      "name": "A Waveshaper Drive",
      "alias": "drive",
      "role": "drive",
      "values": [
        "0.00 dB",
        "6.00 dB",
        "12.00 dB"
      ]
    },
    {
      "name": "A Volume",
      "alias": "volume",
      "role": "level",
      "values": [
        "-12.00 dB",
        "-3.00 dB",
        "0.00 dB"
      ]
    },
    {
      "name": "Scene Mode",
      "alias": "scene_mode",
      "role": "type",
      "description": "Single uses scene A only; Dual plays A+B together; Key Split / Channel Split assign by pitch / MIDI channel",
      "values": [
        "Single",
        "Key Split",
        "Dual",
        "Channel Split"
      ]
    }
  ],
  "presets": [
    {
      "name": "bass",
      "description": "One oscillator an octave down + ladder low-pass, short filter envelope",
      "params": {
        "filter_type": "LP Vintage Ladder",
        "cutoff": "300 Hz",
        "resonance": "30 %",
        "filter_env": "24.00 semitones",
        "filter_decay": "200 ms",
        "filter_sustain": "0.00 %",
        "release": "60 ms",
        "octave": "-1"
      }
    },
    {
      "name": "pad",
      "description": "5-voice unison, slow attack, long tail",
      "params": {
        "filter_type": "LP 12 dB",
        "cutoff": "1500 Hz",
        "attack": "800 ms",
        "release": "2000 ms",
        "unison": "5 voices",
        "detune": "20.00 cents"
      }
    },
    {
      "name": "pluck",
      "description": "No sustain; the filter envelope makes the 'ding'",
      "params": {
        "filter_type": "LP 24 dB",
        "cutoff": "400 Hz",
        "filter_env": "36.00 semitones",
        "filter_decay": "150 ms",
        "filter_sustain": "0.00 %",
        "decay": "400 ms",
        "sustain": "0.00 %",
        "release": "300 ms"
      }
    },
    {
      "name": "lead",
      "description": "Mono glide + light distortion",
      "params": {
        "filter_type": "LP 24 dB",
        "cutoff": "3000 Hz",
        "resonance": "20 %",
        "play_mode": "Mono (Fingered Portamento)",
        "glide": "80 ms",
        "drive_type": "Soft",
        "drive": "6.00 dB"
      }
    }
  ],
  "tips": [
    "In the initial sound Filter 1 is Off: set filter_type first, then cutoff / resonance / filter_env take effect.",
    "Initially only Osc 1 sounds (Osc 2/3 Mute is On); to stack oscillators set osc2_mute / osc3_mute to Off.",
    "Oscillators default to free-running phase, so each render differs slightly; the setup turns on Retrigger for all three oscillators so results are reproducible.",
    "The initial release is only 31 ms, so long notes cut off on release; raise release for pads.",
    "Scene B parameters have the same names as A (with a leading B) and are silent by default (Scene Mode is Single, A only).",
    "FX A1-A4, FX B1-B4 and Send FX are Surge's built-in effect slots and can be set through parameters too; you can also put Surge XT Effects on a track."
  ]
}
